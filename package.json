{
  "name": "mermaidjs-desktop-client",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Desktop editor for Mermaid diagrams with real-time preview, syntax highlighting, and SVG/PNG export.",
  "homepage": "https://github.com/skydiver/mermaidjs-desktop-client",
  "license": "MIT",
  "author": "Martín M.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist src-tauri/target"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.39.0",
    "@lezer/highlight": "^1.2.0",
    "@mermaid-js/mermaid-zenuml": "^0.2.2",
    "@tailwindcss/vite": "^4.2.0",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-store": "^2.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "codemirror": "^6.0.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.13.0",
    "radix-ui": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "rimraf": "^6.1.0",
    "shadcn": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
